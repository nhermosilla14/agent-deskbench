  "cards": [
    {
      "dot": "cyan",
      "title": "Agent path",
      "items": [
        "CLI is the only supported entry point",
        "exec / shot / stop drive the container",
        "Podman holds the state, never the tray"
      ]
    },
    {
      "dot": "emerald",
      "title": "Human path",
      "items": [
        "Tray icon exists only while a desktop runs",
        "One browser tab per desktop, full input",
        "ask blocks until you press Done"
      ]
    },
    {
      "dot": "amber",
      "title": "Lifecycle",
      "items": [
        "First new spawns the tray, which holds a flock",
        "Last stop or container die exits it",
        "Nothing stays resident between sessions"
      ]
    }
  ]
